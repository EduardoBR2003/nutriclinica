# Copie para .env e ajuste os valores. O arquivo .env NUNCA é versionado.

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_DB=nutriclinica
POSTGRES_USER=nutriclinica
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# ---------- Backend (Spring Boot) ----------
# Em dev, os valores abaixo apontam para o Postgres do docker-compose.
DB_URL=jdbc:postgresql://localhost:5432/nutriclinica
DB_USERNAME=nutriclinica
DB_PASSWORD=troque-esta-senha

# Perfil ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8080
