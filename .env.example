# Copie para .env e ajuste os valores. O arquivo .env NUNCA é versionado.

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_DB=nutriclinica
POSTGRES_USER=nutriclinica
POSTGRES_PASSWORD=troque-esta-senha
# Porta no host. 5433 evita conflito com um Postgres nativo na 5432.
POSTGRES_PORT=5433

# ---------- Backend (Spring Boot) ----------
# Em dev, os valores abaixo apontam para o Postgres do docker-compose (porta do host).
DB_URL=jdbc:postgresql://localhost:5433/nutriclinica
DB_USERNAME=nutriclinica
DB_PASSWORD=troque-esta-senha

# Perfil ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Segredo de assinatura do JWT (HS256). Minimo de 32 bytes.
# Em dev existe um default no application.yml; em producao esta variavel e obrigatoria.
# Gere um valor novo com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-bytes

# Origens liberadas no CORS, separadas por virgula. Obrigatoria em producao.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8080
