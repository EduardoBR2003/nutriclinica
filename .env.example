# Copie para .env e ajuste os valores. O arquivo .env NUNCA é versionado.

# ---------- PostgreSQL (docker-compose) ----------
POSTGRES_DB=nutriclinica
POSTGRES_USER=nutriclinica
POSTGRES_PASSWORD=troque-esta-senha
# Porta no host. 5433 evita conflito com um Postgres nativo na 5432.
POSTGRES_PORT=5433

# ---------- Backend (Spring Boot) ----------
# Este arquivo e lido pelo backend no perfil dev: o application.yml o importa
# via spring.config.import, entao mudar DB_URL aqui basta para o
# `./mvnw spring-boot:run` apontar para outro banco — sem editar arquivo
# versionado. Variavel de ambiente de verdade continua vencendo o .env.
# Em dev, os valores abaixo apontam para o Postgres do docker-compose (porta do host).
DB_URL=jdbc:postgresql://localhost:5433/nutriclinica
DB_USERNAME=nutriclinica
DB_PASSWORD=troque-esta-senha

# Perfil ativo: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Segredo de assinatura do JWT (HS256). Minimo de 32 bytes.
# Em dev existe um default no application.yml; em producao esta variavel e obrigatoria.
# Gere um valor novo com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-32-bytes

# Origens liberadas no CORS, separadas por virgula. Obrigatoria em producao.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Administrador inicial (somente perfil prod) ----------
# Sao lidas pelo AdminInicialRunner, que cria o unico administrador da base
# quando a tabela usuario esta vazia. No perfil prod a aplicacao RECUSA subir
# se faltarem. Em dev nao sao usadas: quem semeia e o SeedDesenvolvimentoRunner.
# A senha tem minimo de 12 caracteres e deve ser trocada no primeiro acesso.
ADMIN_EMAIL=admin@suainstituicao.edu.br
ADMIN_PASSWORD=troque-esta-senha-de-administrador

# Para apontar o dev a um Postgres hospedado (Neon), troque as tres linhas
# acima pela URL do provedor. Atencao: o SeedDesenvolvimentoRunner roda no
# perfil dev e criaria os tres usuarios de demonstracao (senha publicada)
# nesse banco — use um branch de desenvolvimento do Neon, nunca o de producao.

# ---------- Producao (Render + Neon) ----------
# O perfil prod NAO le DB_URL/DB_USERNAME/DB_PASSWORD: ele usa os nomes
# canonicos do Spring, que e o que os paineis de deploy costumam sugerir.
# Nenhuma delas tem default — faltando qualquer uma, a aplicacao recusa subir.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=
# JWT_SECRET, CORS_ALLOWED_ORIGINS, ADMIN_EMAIL e ADMIN_PASSWORD acima tambem
# sao obrigatorias em prod.

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8080
